# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose to the client

# Rubric grader
ANTHROPIC_API_KEY=

# Speech-to-text (src/lib/stt). OpenAI transcribes; a local Parakeet/OruKey server can take over later.
OPENAI_API_KEY=                   # server-only
STT_PROVIDER=openai               # openai | local
STT_MODEL=                        # blank = gpt-transcribe (openai) or parakeet (local)
STT_FALLBACK=openai:whisper-1     # tried once if the main model is down; "none" turns it off
STT_LOCAL_URL=                    # local only, e.g. http://127.0.0.1:8000/v1
STT_LOCAL_API_KEY=                # local only, if the server wants a key; server-only
# Changing STT_PROVIDER or STT_FALLBACK changes the privacy notice: members are asked to accept it again.

# Vercel Cron (vercel.json) retries failed check-in processing; it sends this as a Bearer token.
CRON_SECRET=                      # server-only; a long random string, e.g. `openssl rand -hex 32`
