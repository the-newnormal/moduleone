# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose to the client. Used only by "Give login", "Resend invite", "Change email", "Remove from Module One" (deleting the login) and the check-in (src/lib/supabase/admin.ts)

# This site's own URL, no trailing slash (e.g. https://moduleone.vercel.app; locally http://localhost:3000).
# Must match Supabase Auth's Site URL (Authentication → URL Configuration): the invite email's link is
# built from that, and "Give login" sends <NEXT_PUBLIC_SITE_URL>/auth/callback as the invite's redirect.
NEXT_PUBLIC_SITE_URL=

# Rubric grader
ANTHROPIC_API_KEY=                # server-only
ANTHROPIC_MODEL=claude-haiku-5-5  # blank = claude-haiku-5-5; claude-sonnet-5-5 if Haiku's reviews are too thin

# Speech-to-text (src/lib/stt). OpenAI transcribes; a local Parakeet/OruKey server can take over later.
OPENAI_API_KEY=                   # server-only
STT_PROVIDER=openai               # openai | local
STT_MODEL=                        # blank = gpt-transcribe (openai) or parakeet (local)
STT_FALLBACK=openai:whisper-1     # tried once if the main model is down; "none" turns it off
STT_LOCAL_URL=                    # local only, e.g. http://127.0.0.1:8000/v1
STT_LOCAL_API_KEY=                # local only, if the server wants a key; server-only
# Changing STT_PROVIDER or STT_FALLBACK changes the privacy notice: members are asked to accept it again.
# Retries use the current setting, so let ungraded check-ins finish before switching to another service.

# Vercel Cron (vercel.json) runs the daily job (retry failed processing, delete recordings after 90 days);
# it sends this as a Bearer token.
CRON_SECRET=                      # server-only; a long random string, e.g. `openssl rand -hex 32`
