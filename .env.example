# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose to the client. Used only by "Give login" and "Resend invite" (src/lib/supabase/admin.ts)

# This site's own URL, no trailing slash (e.g. https://moduleone.vercel.app; locally http://localhost:3000).
# Invite links from "Give login" come back to <NEXT_PUBLIC_SITE_URL>/auth/callback.
NEXT_PUBLIC_SITE_URL=

# Rubric grader
ANTHROPIC_API_KEY=

# Speech-to-text (web API for now; swap to local Parakeet/OruKey later)
STT_PROVIDER=web                  # web | local
STT_API_KEY=
